# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/email_notification?schema=public"

# Сессия админки. Случайная строка не короче 32 символов.
AUTH_SECRET=""
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""

# 32 байта в base64 для AES-256-GCM. Сгенерируйте: npm run secrets
ENCRYPTION_KEY=""

# Защита cron-эндпоинтов. Vercel передаёт его как Authorization: Bearer.
CRON_SECRET=""

# mock — заглушка Битрикс24. webhook — реальный исходящий веб-хук.
B24_MODE="mock"
# Необязательно: начальный URL. После сохранения в админке используется значение из базы.
B24_WEBHOOK_URL=""
